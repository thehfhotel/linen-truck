# linen-truck — local development (docs/CONTRACTS.md §1).
#
# Copy to .env (gitignored) and adjust. PLACEHOLDERS ONLY in this file: the repo
# is public (§13), so no device id, no password, no token and no address may ever
# be written here. Production values are GitHub secrets, rendered by CI into the
# deploy payload's .env on the HF Ville box and never committed anywhere.

PORT=4100
TZ=Asia/Bangkok
DATA_DIR=./data
# Origin for links; production is the Access-gated hostname.
PUBLIC_URL=http://localhost:4100
# Echoed by /healthz so a deploy can be confirmed against the commit that shipped.
GIT_SHA=unknown

# ── SinoTrack platform ──────────────────────────────────────────────────────
# The cluster server that hosts the account (the login page redirects to it).
# Must be https: the device password is posted to it, and boot fails otherwise.
SINOTRACK_SERVER=https://242.sinotrack.com
# The 10-digit device id, which is also the login on this account. The real pair
# lives in the secrets TRUCK_SINOTRACK_USER / TRUCK_SINOTRACK_PASSWORD and in the
# private ops note — never here. Leave BOTH EMPTY for ordinary local work: the
# poller then stays dormant (logged once) and the day pages read whatever
# `bun scripts/import.ts` seeded.
SINOTRACK_USER=<10-digit device id>
SINOTRACK_PASSWORD=<device password>
# Defaults to SINOTRACK_USER. Set it on its own when seeding an archive without
# credentials — `points` is keyed by device id, so it must match.
SINOTRACK_TEID=
POLL_INTERVAL_SECONDS=600
POLL_WINDOW_HOURS=48

# ── auth ────────────────────────────────────────────────────────────────────
# Leave the audience empty locally and use the dev bypass below: the server then
# 503s every page and API, which is the correct fail-closed behaviour and exactly
# what production does before its secret is set.
# The team domain is not a secret — it is on every login redirect. The audience
# tag is: it arrives from the secret TRUCK_CF_ACCESS_AUD.
CF_ACCESS_TEAM_DOMAIN=laikaexpress.cloudflareaccess.com
CF_ACCESS_AUD=

# DEV ONLY. Makes the X-Dev-Email header stand in for the Cloudflare Access JWT.
# The server refuses it outright under NODE_ENV=production, and it is ignored the
# moment CF_ACCESS_AUD is set — never set it in a deployed environment.
ALLOW_DEV_AUTH=1

# ── internal feed (hf-mcp owner report) ─────────────────────────────────────
# Bearer token hf-mcp presents on GET /feed/daily and /feed/range. Empty = the
# feed does not exist and answers 404. Server-to-server only; the routes also
# 404 anything that arrived through Cloudflare. Production's value is the secret
# TRUCK_FEED_TOKEN; generate a throwaway one locally with `openssl rand -hex 32`.
FEED_TOKEN=

# ── proxy trust ─────────────────────────────────────────────────────────────
# Only these peers may set CF-Connecting-IP. cloudflared runs on the same box and
# reaches the container over loopback; the /12 is the Docker bridge range.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# ── nightly backup ──────────────────────────────────────────────────────────
# Bangkok HH:MM for the in-process VACUUM INTO ${DATA_DIR}/backups/ (keep 14).
# Set it EMPTY to turn backups off entirely — e.g. on a laptop. There is no host
# timer on the box, so this scheduler is the only backup there is.
BACKUP_TIME=02:35
